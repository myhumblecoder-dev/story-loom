generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model JournalEntry {
  id        String    @id @default(cuid())
  text      String
  createdAt DateTime  @default(now())
  @@index([createdAt])
}

model WeeklyStory {
  id        String    @id @default(cuid())
  weekStart DateTime
  story     String
  createdAt DateTime  @default(now())
  @@index([weekStart])
  @@index([createdAt])
}